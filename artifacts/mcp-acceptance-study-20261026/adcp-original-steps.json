[
  {
    "id": "unknown_scenario",
    "title": "Unknown scenario returns error",
    "requires_tool": "comply_test_controller",
    "narrative": "Send a nonexistent scenario name. The controller should return\nUNKNOWN_SCENARIO error code.\n",
    "task": "comply_test_controller",
    "comply_scenario": "controller_validation",
    "stateful": false,
    "expect_error": true,
    "expected": "Return an error response with:\n- success: false\n- error: UNKNOWN_SCENARIO\n",
    "sample_request": {
      "scenario": "nonexistent_scenario",
      "params": {}
    },
    "validations": [
      {
        "check": "field_value",
        "path": "success",
        "allowed_values": [
          false
        ],
        "description": "Unknown scenario fails"
      },
      {
        "check": "field_value",
        "path": "error",
        "allowed_values": [
          "UNKNOWN_SCENARIO"
        ],
        "description": "Error code is UNKNOWN_SCENARIO"
      }
    ]
  },
